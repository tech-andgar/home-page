<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Software Development on TECH-ANDGAR</title><link>https://tech-andgar.me/categories/software-development/</link><description>Recent content in Software Development on TECH-ANDGAR</description><generator>Hugo</generator><language>en</language><lastBuildDate>Sat, 11 Oct 2025 00:00:00 +0000</lastBuildDate><atom:link href="https://tech-andgar.me/categories/software-development/index.xml" rel="self" type="application/rss+xml"/><item><title>Missing Dart? When TypeScript Feels Like a Desert</title><link>https://tech-andgar.me/posts/dart-vs-typescript-switch-expressions-collection-control-flow/</link><pubDate>Sat, 11 Oct 2025 00:00:00 +0000</pubDate><guid>https://tech-andgar.me/posts/dart-vs-typescript-switch-expressions-collection-control-flow/</guid><description>&lt;h2 id="missing-dart-when-typescript-feels-like-a-desert"&gt;
